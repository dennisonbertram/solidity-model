pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {console2} from "forge-std/console2.sol";
import {OnChainLLM} from "../src/OnChainLLM.sol";

contract OnChainLLMTest is Test {
    OnChainLLM llm;

    function setUp() public {
        llm = new OnChainLLM();
    }

    function testVocab() public view {
        string memory v = llm.vocab();
        assertEq(bytes(v).length, 29);
        assertEq(v, "abcdefghijklmnopqrstuvwxyz .,");
    }

    function testNextTokenLogitsShapeAndDeterminism() public view {
        int256[] memory logits1 = llm.nextTokenLogits("four sco");
        int256[] memory logits2 = llm.nextTokenLogits("four sco");
        assertEq(logits1.length, 29);
        // pure forward pass must be deterministic given the same context
        for (uint256 i = 0; i < logits1.length; i++) {
            assertEq(logits1[i], logits2[i]);
        }
    }

    function testNextTokenLogitsRejectsUnknownChar() public {
        vm.expectRevert("char not in vocab");
        llm.nextTokenLogits("Four");  // capital F not in vocab
    }

    function testNextTokenLogitsRejectsEmpty() public {
        vm.expectRevert("empty context");
        llm.nextTokenLogits("");
    }

    function testGenerateShortPrompt() public {
        // shorter than the model's context window (8)
        string memory out = llm.generate("dear", 10, 42);
        assertEq(bytes(out).length, 4 + 10);
        console2.log("prompt='dear' ->", out);
    }

    function testGenerateFullWindowAndSliding() public {
        // longer than context window, exercises the sliding-window path
        string memory out = llm.generate("four score and seven years ago", 8, 7);
        assertEq(bytes(out).length, 30 + 8);
        console2.log("prompt='four score and seven years ago' ->", out);
    }

    function testGenerateEmitsEvent() public {
        vm.expectEmit(true, false, false, false);
        emit OnChainLLM.Generated(address(this), 1, "dedicate", "");
        llm.generate("dedicate", 5, 1);
    }

    function testGenerateRejectsBadArgs() public {
        vm.expectRevert("empty prompt");
        llm.generate("", 5, 0);

        vm.expectRevert("numTokens out of range");
        llm.generate("hello", 0, 0);

        vm.expectRevert("numTokens out of range");
        llm.generate("hello", 65, 0);
    }

    function testGenerateOnlyValidVocabChars() public {
        string memory out = llm.generate("the people", 20, 123);
        bytes memory ob = bytes(out);
        for (uint256 i = 0; i < ob.length; i++) {
            bytes1 c = ob[i];
            bool ok = (c >= 0x61 && c <= 0x7a) || c == 0x20 || c == 0x2e || c == 0x2c;
            assertTrue(ok, "generated byte outside vocab");
        }
    }

    // Regression guard: cost per token must stay roughly linear (a prior bug
    // made `bytes constant` reads re-expand memory per access, which made
    // this quadratic — 20 tokens cost 140M gas instead of ~140M/20≈7M each).
    function testGasScalesLinearlyWithTokenCount() public {
        uint256 g0 = gasleft();
        llm.generate("four score and seven years ago", 4, 99);
        uint256 used4 = g0 - gasleft();

        OnChainLLM llm2 = new OnChainLLM();
        g0 = gasleft();
        llm2.generate("four score and seven years ago", 16, 99);
        uint256 used16 = g0 - gasleft();

        console2.log("gas for 4 tokens:", used4);
        console2.log("gas for 16 tokens:", used16);
        // 4x the tokens should cost well under 4x the gas plus a fixed
        // overhead slop — not the O(n^2) blowup the old bug produced.
        assertLt(used16, used4 * 5, "gas is not scaling linearly with token count");
    }
}
